<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مقر DXN الدار النعيم - المتجر والكتالوج الرسمي</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f8f6;--fg:#1b2e21;--card:#fff;--muted:#5d6f63;--line:#dfe8e1;--g:#2d6a3e;--gh:#235431;--gl:#edf5ef;--hero1:#f3f8f4;--hero2:#d3e7d8;--ticker:#14452a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a13;--fg:#e8f1ea;--card:#17261c;--muted:#9db3a3;--line:#27402f;--g:#3f9457;--gh:#4aa763;--gl:#1b3023;--hero1:#14231a;--hero2:#1d3626;--ticker:#0a2616}}
:root[data-theme="dark"]{--bg:#0f1a13;--fg:#e8f1ea;--card:#17261c;--muted:#9db3a3;--line:#27402f;--g:#3f9457;--gh:#4aa763;--gl:#1b3023;--hero1:#14231a;--hero2:#1d3626;--ticker:#0a2616}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;font-family:'Cairo',Tahoma,Arial,sans-serif;background:var(--bg);color:var(--fg)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--card);z-index:60}
button,input,select{font-family:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--card);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.logo{width:46px;height:46px;border-radius:12px;background:var(--g);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;overflow:hidden;flex:none}
.logo img{width:100%;height:100%;object-fit:contain;background:#fff}
h1{font-size:16px;margin:0;font-weight:800;line-height:1.3}
.sub{font-size:11px;color:var(--g);font-weight:700}
.flag{display:inline-block;width:34px;height:23px;border-radius:3px;overflow:hidden;vertical-align:middle;margin-inline-start:6px;box-shadow:0 2px 6px rgba(0,0,0,.2);transform-origin:right center;animation:wave 2.8s ease-in-out infinite}
.flag svg{width:100%;height:100%;display:block}
@keyframes wave{0%,100%{transform:perspective(160px) rotateY(-10deg) skewY(1.5deg)}50%{transform:perspective(160px) rotateY(10deg) skewY(-2deg)}}
.btn{border:0;cursor:pointer;background:var(--g);color:#fff;font-weight:700;font-size:13px;padding:10px 16px;border-radius:12px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
.btn:hover{background:var(--gh)}
.btn.alt{background:var(--card);color:var(--g);border:1px solid var(--line)}
.badge{background:#fff;color:#14452a;border-radius:99px;padding:0 8px;font-size:12px;font-weight:900}
.ticker{background:var(--ticker);color:#fff;overflow:hidden;font-size:12px;font-weight:600;padding:6px 0}
.track{display:flex;gap:32px;width:max-content;animation:tick 55s linear infinite}
.ticker:hover .track{animation-play-state:paused}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(50%)}}
.hero{background:linear-gradient(135deg,var(--hero1),var(--hero2));padding:32px 0;border-bottom:1px solid var(--line)}
.hero .wrap{display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between}
.hero h2{font-size:clamp(22px,4vw,34px);font-weight:900;margin:8px 0;line-height:1.4}
.hero h2 span{color:var(--g)}
.hero p{color:var(--muted);margin:0 0 14px;max-width:560px}
.tag{display:inline-block;background:var(--card);border:1px solid var(--line);color:var(--g);padding:4px 12px;border-radius:99px;font-size:12px;font-weight:700}
.actions{display:flex;flex-wrap:wrap;gap:10px}
.pay{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;width:300px;max-width:100%}
.pay h3{margin:0 0 10px;font-size:14px;color:var(--g)}
.pay div.g{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;font-weight:700}
.pay div.g div{background:var(--gl);border-radius:10px;padding:9px;text-align:center}
.pay small{display:block;text-align:center;color:var(--muted);margin-top:10px;font-size:11px}
.tools{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;margin:24px 0 16px}
.cats{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;max-width:100%}
.cat{border:1px solid var(--line);background:var(--card);color:var(--fg);padding:8px 16px;border-radius:12px;font-weight:700;font-size:13px;white-space:nowrap;cursor:pointer}
.cat.on{background:var(--g);color:#fff;border-color:var(--g)}
.search{border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:12px;padding:10px 14px;font-size:14px;width:280px;max-width:100%}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;margin-bottom:32px}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between}
.pic{height:170px;background:linear-gradient(135deg,var(--gl),var(--hero2));display:flex;align-items:center;justify-content:center;font-size:54px;position:relative}
.pic b{position:absolute;top:8px;right:8px;background:var(--card);color:var(--g);font-size:11px;padding:3px 9px;border-radius:8px}
.pic i{position:absolute;bottom:8px;left:8px;background:var(--g);color:#fff;font-style:normal;font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px}
.pic img{width:100%;height:100%;object-fit:contain;background:#fff}.card .t{padding:14px}
.card h3{font-size:15px;margin:0 0 6px;line-height:1.5}
.card p{margin:0;font-size:12px;color:var(--muted);line-height:1.7}
.foot{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-top:1px solid var(--line)}
.price{font-size:19px;font-weight:900;color:var(--g)}
.price small{font-size:11px;color:var(--muted);font-weight:700}
h2.sec{font-size:20px;font-weight:900;margin:8px 0 14px}
.pages{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:32px}
.pages img{width:100%;border-radius:14px;border:1px solid var(--line);display:block}
.empty{background:var(--card);border:2px dashed var(--line);border-radius:16px;padding:24px;text-align:center;color:var(--muted);font-size:13px}
footer{background:var(--ticker);color:#cfe3d4;text-align:center;padding:20px 16px;font-size:13px;line-height:2}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:70;display:flex;justify-content:flex-start}
.side{background:var(--card);width:100%;max-width:420px;height:100%;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom,0px)}
.side header{position:static;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;background:var(--gl)}
.side header h3{margin:0;font-size:17px}
.x{border:0;background:var(--card);color:var(--fg);width:32px;height:32px;border-radius:50%;cursor:pointer;font-weight:900}
.body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
.item{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--gl);border-radius:12px;padding:10px}
.item h4{margin:0;font-size:13px}.item p{margin:2px 0 0;font-size:12px;color:var(--g);font-weight:700}
.qty{display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:2px 8px}
.qty button{border:0;background:none;color:var(--fg);font-size:18px;font-weight:900;cursor:pointer}
.in{width:100%;border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:12px;padding:10px;font-size:14px}
.total{display:flex;justify-content:space-between;font-weight:900;font-size:17px;padding:14px;border-top:1px solid var(--line)}
.side .btn{margin:0 14px 14px;justify-content:center;padding:13px}
@media print{header,.tools,.foot button,.ov{display:none!important}}

.tb{background:var(--gl);color:var(--g);text-align:center;font-size:12px;font-weight:700;padding:4px}
.flag.big{width:96px;height:64px;margin:0}
.promo{background:linear-gradient(90deg,#b4261f,#d97706);color:#fff;padding:12px 0}
.promo .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.cd{display:flex;gap:8px}.cd span{background:rgba(0,0,0,.28);border-radius:10px;padding:6px 10px;text-align:center;font-size:11px;min-width:54px}.cd b{display:block;font-size:20px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-top:20px}
.st{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;text-align:center}.st b{display:block;font-size:28px;color:var(--g);font-weight:900}.st span{font-size:12px;color:var(--muted)}
.off{position:absolute;top:8px;left:8px;background:#d01c1f;color:#fff;text-decoration:none;font-weight:800;font-size:12px;padding:3px 9px;border-radius:8px}
.price s{font-size:12px;color:var(--muted);font-weight:600}
[dir=ltr] .flag{transform-origin:left center}
[dir=ltr] .track{animation-name:tickL}
@keyframes tickL{from{transform:translateX(0)}to{transform:translateX(-50%)}}
</style>
</head>
